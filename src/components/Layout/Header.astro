---
import Logo from "./Logo.astro";
import Icon from "../Icon.astro";

/**
 * The site header: mark on the left, navigation and the icon rail on the right, separated from
 * the page by the interactive border weight.
 *
 * The redesign replaced the full-width butterfly that used to sit here. That header was 250px
 * tall and pushed every post below the fold.
 */

// Astro emits directory-style URLs, so `/archive` arrives as `/archive/`. Strip the trailing
// slash before matching, and keep the root as a bare `/`.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const mainLinks = [
    {href: "/", label: "Home"},
    {href: "/archive", label: "Archive"},
    {href: "/archive/spanish-legacy-post", label: "Spanish legacy posts"},
    {href: "/constitution", label: "Constitution"},
    {href: "/authors", label: "Authors"},
];

const iconLinks = [
    {href: "/rss.xml", icon: "rss", label: "RSS feed", external: false},
    {href: "https://github.com/iokode", icon: "github", label: "GitHub", external: true},
    {href: "https://x.com/iokode_blog", icon: "twitter", label: "X.com", external: true},
    {href: "https://www.linkedin.com/company/82665045", icon: "linkedin", label: "LinkedIn", external: true},
] as const;

// `/archive` must not light up while the reader is on `/archive/spanish-legacy-post`, so the
// longest matching prefix wins rather than the first.
const activeHref = mainLinks
    .filter(link => path === link.href || path.startsWith(`${link.href}/`))
    .sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<header>
    <Logo size={40}/>

    <div class="navigation">
        <nav aria-label="Main">
            <ul class="main-links">
                {mainLinks.map(link => (
                    <li>
                        <a class="nav-link" href={link.href} aria-current={link.href === activeHref ? "page" : undefined}>
                            {link.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>

        <ul class="icon-links">
            {iconLinks.map(link => (
                <li>
                    <a
                        class="icon-button"
                        href={link.href}
                        aria-label={link.label}
                        title={link.label}
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noopener" : undefined}
                    >
                        <Icon name={link.icon}/>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</header>

<style>
    header {
        /* Box model */
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-5) var(--space-7);
        padding: var(--space-6) 0 var(--space-7);

        /* Visual */
        border-bottom: var(--border-default-width) solid var(--border-subtle);
    }

    .navigation {
        /* Box model */
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3) var(--space-5);
        margin-left: auto;
    }

    .main-links,
    .icon-links {
        /* Box model */
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-1);
        margin: 0;
        padding: 0;

        > li {
            /* Box model */
            margin: 0;

            /* Visual */
            list-style-type: none;
        }
    }
</style>
