---
import {icons, type IconName} from "../helpers/icons";

/**
 * Lucide glyphs, drawn with the brand's geometry rather than Lucide's defaults: 2px stroke, square
 * line caps and miter joins, so the icons match a system whose corners are all square.
 *
 * Icons never appear without an accessible name. Either pass `label`, or leave it off only when
 * the icon sits beside text that already names the control.
 */

interface Props {
    name: IconName;
    size?: number;
    /** Accessible name. Omit only when adjacent text already labels the icon. */
    label?: string;
}

const {name, size = 18, label} = Astro.props;
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="square"
    stroke-linejoin="miter"
    role={label ? "img" : "presentation"}
    aria-label={label}
    aria-hidden={label ? undefined : "true"}
    focusable="false"
    set:html={icons[name]}
/>

<style>
    svg {
        /* Box model */
        display: block;
        flex: none;
    }
</style>
