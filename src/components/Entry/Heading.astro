---
import {slugify} from "../../helpers/slug";

/**
 * Headings inside post bodies.
 *
 * astro-remote renders Markdown with `marked`, which emits headings without ids, so nothing in a
 * post body could be linked to. This override gives every heading a deterministic anchor — which
 * is what makes both the table of contents and a shared link to a section work.
 *
 * `as` is `h1`…`h6` and `text` is the raw Markdown source of the heading; astro-remote supplies
 * both through its renderer rather than from a call site in this repository.
 */

type Level = 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';

const {as, text} = Astro.props as { as: string, text: string };

const isLevel = (value: string): value is Level => /^h[1-6]$/.test(value);
const Tag: Level = isLevel(as) ? as : 'h2';

const id = slugify(text);
---

<Tag id={id || undefined}><slot/></Tag>
