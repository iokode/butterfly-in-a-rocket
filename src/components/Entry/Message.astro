---
/**
 * A chat bubble for posts that quote a conversation. Not a design-system component — it borrows
 * the card treatment and the tokens.
 *
 * The tail used to be a hardcoded white triangle, which vanished against the dark theme. It is
 * now drawn in a token, so it survives both.
 */

interface Props {
    direction: 'me' | 'other';
}

const {direction} = Astro.props;
---

<div class:list={["message", direction]}>
    <slot/>
</div>

<style>
    .message {
        /* Positioning */
        position: relative;

        /* Box model */
        display: block;
        width: fit-content;
        max-width: min(100%, 34em);
        padding: var(--space-3) var(--space-6);
        margin-bottom: var(--space-6);

        /* Visual */
        background-color: var(--surface-card);
        border: var(--border-thin) solid var(--border-subtle);
        border-radius: var(--radius-sm);

        &:last-child {
            /* Box model */
            margin-bottom: 0;
        }

        /* The tail. Drawn as a border triangle in the same token as the bubble edge, so it reads
           as a nub in either theme. */
        &::after {
            /* Positioning */
            position: absolute;
            bottom: -1px;

            /* Box model */
            content: '';

            /* Visual */
            border-style: solid;
            border-color: transparent;
        }
    }

    .message.me {
        /* Box model */
        margin-left: auto;

        /* Visual */
        background-color: var(--accent-subtle);
        border-color: var(--border-accent);

        &::after {
            /* Positioning */
            right: -1em;

            /* Visual */
            border-width: 0.5em 0 0 1em;
            border-left-color: var(--border-accent);
        }
    }

    .message.other {
        &::after {
            /* Positioning */
            left: -1em;

            /* Visual */
            border-width: 0.5em 1em 0 0;
            border-right-color: var(--border-subtle);
        }
    }
</style>
