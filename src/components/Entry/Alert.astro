---
import {Markdown} from "astro-remote";
import Icon from "../Icon.astro";

/**
 * A callout inside post bodies. Authors write `<Alert severity="note">` in their Markdown, so the
 * component name and its prop are content-facing and fixed; only the presentation is the design
 * system's business.
 *
 * The design system maps one glyph to each tone and does not vary them.
 */

interface Props {
    severity: "note" | "warning";
    /** Optional heading. Without one, the body sits alongside the icon on its own. */
    title?: string;
}

const icons = {
    note: 'sparkle',
    info: 'info',
    success: 'check',
    warning: 'triangle-alert',
    danger: 'octagon-x',
} as const;

const {severity, title} = Astro.props;
const renderedSlot = await Astro.slots.render('default');
---

<div class:list={["callout", severity]}>
    <span class="icon"><Icon name={icons[severity] ?? 'info'} size={20} label={severity}/></span>
    <div class="body">
        {title && <p class="title">{title}</p>}
        <Markdown content={renderedSlot}/>
    </div>
</div>
