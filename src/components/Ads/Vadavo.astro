---
/** Sponsor block for the aside. Not part of the design system — a commercial slot that borrows
 *  its card and tokens. */
---

<section class="card accent sponsor">
    <h2 class="eyebrow">Need hosting?</h2>
    <p>
        <a rel="sponsored noopener" target="_blank" href="https://www.vadavo.com/hosting">Get <strong>10% off</strong> at VADAVO</a>
        using the <code>IOKODE</code> code.
    </p>
</section>

<style>
    .sponsor {
        /* Typographic */
        font-size: var(--font-size-sm);

        > p {
            /* Box model */
            margin: 0;
        }
    }
</style>
