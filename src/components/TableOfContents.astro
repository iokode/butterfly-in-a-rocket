---
/**
 * "On this page" — the section index for an article.
 *
 * Only `##` headings appear. A post deep enough to need three levels of index is a post that
 * wants splitting, and the blog column is not wide enough to indent a third level legibly.
 */

interface Props {
    items: { id: string, label: string }[];
}

const {items} = Astro.props;
---

{items.length > 0 && (
    <nav class="table-of-contents" aria-label="On this page">
        <p class="title">On this page</p>
        <ul>
            {items.map(item => (
                <li><a href={`#${item.id}`}>{item.label}</a></li>
            ))}
        </ul>
    </nav>
)}
