---
import type {CollectionEntry} from 'astro:content';
import {getCollection} from 'astro:content';
import TagList from "./TagList.astro";
import {getImage} from "astro:assets";
import {repository} from "../content.config";
import {getCommentCounts} from "../helpers/discussions";
import PostMeta from "./PostMeta.astro";
import Icon from "./Icon.astro";

/**
 * A post as it appears in an index. Byline, title, then the actions.
 *
 * No excerpt: the index shows what a post is, not a preview of it. And the whole card is not one
 * link — the title, the author, each tag and each button go to different places, and nesting
 * those inside an outer anchor would be invalid and unusable with a keyboard.
 */

interface Props {
    post: CollectionEntry<'posts'>;
}

const {data} = Astro.props.post;

// `data.license` is the collection id, not something to show a reader. Resolve it to the code.
const allLicenses = await getCollection('licenses');
const license = allLicenses.find(entry => entry.id === data.license)?.data;

const avatar = await getImage({
    src: `https://github.com/${data.author}.png?size=60`,
    formats: ['webp'],
    inferSize: true,
    quality: 'max',
});

const href = `/posts/${data.slug}`;
const discussionHref = `https://github.com/${repository}/discussions/${data.discussionId}`;

// "N comments" when the count is known, "Discuss" when it is not — the design system's fallback.
const commentCount = (await getCommentCounts()).get(data.discussionId);
const discussLabel = commentCount === undefined
    ? 'Discuss'
    : `${commentCount} ${commentCount === 1 ? 'comment' : 'comments'}`;
---

<article class="post-card">
    <PostMeta
        publishDate={data.publishDate}
        author={data.author}
        authorName={data.authorName}
        avatarSrc={avatar.src}
        license={license}
    />

    <h2 class="title"><a href={href}>{data.title}</a></h2>

    {data.series && <p class="series">Part of the <strong>{data.series}</strong> series</p>}

    <div class="footer">
        <a class="button small" href={href}>
            Read post
            <Icon name="arrow-right" size={15}/>
        </a>

        <a class="button ghost small" href={discussionHref} target="_blank" rel="noopener">
            <Icon name="message-square" size={15}/>
            {discussLabel}
        </a>

        <TagList tags={data.tags}/>
    </div>
</article>

<style>
    .post-card {
        /* Box model */
        display: grid;
        gap: var(--space-4);
        padding-bottom: var(--space-8);

        /* Visual */
        border-bottom: var(--border-thin) solid var(--border-subtle);
    }

    .title {
        /* Box model */
        margin: 0;
        padding: 0;

        /* Typographic */
        font-size: var(--font-size-xl);
        font-weight: var(--weight-semibold);

        > a {
            /* Typographic */
            color: var(--text-strong);

            &:hover {
                /* Typographic */
                color: var(--text-link);
                text-decoration: none;
            }
        }
    }

    .series {
        /* Box model */
        margin: 0;

        /* Typographic */
        font-family: var(--font-mono);
        font-size: var(--font-size-xs);
        color: var(--text-muted);

        > strong {
            /* Typographic */
            font-weight: var(--weight-semibold);
            color: var(--text-link);
        }
    }

    .footer {
        /* Box model */
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4);
        margin-top: var(--space-2);
    }
</style>
