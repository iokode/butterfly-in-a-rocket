---
import {getCollection, getEntry} from "astro:content";
import {Markdown} from 'astro-remote';
import PostLayout from "../../layouts/PostLayout.astro";
import Comments from "../../components/Comments.svelte";
import {entryComponents} from "../../components/Entry/components";
import {extractHeadings} from "../../helpers/slug";

export const getStaticPaths = async function () {
    const posts = await getCollection('posts');

    const mappedPosts = posts.map(async post => {
        const license = (await getEntry('licenses', post.data.license))!;

        return {
            params: {slug: post.data.slug},
            props: {
                body: post.body ?? '',
                // The loader ids a post by its directory, e.g. `posts/54-rocket`.
                entryId: post.id,
                post: post.data as {
                    author: string,
                    title: string,
                    publishDate: Date,
                    slug: string,
                    discussionId: number,
                    tags: string[],
                },
                license: license.data,
            }
        }
    })

    return Promise.all(mappedPosts);
};

// Read off the raw Markdown rather than the rendered HTML, because astro-remote hands back a
// string that is already escaped and inserted.
const headings = extractHeadings(Astro.props.body);
---

<PostLayout
    {...Astro.props.post}
    license={Astro.props.license}
    headings={headings}
    entryId={Astro.props.entryId}
>
    <div class="prose">
        <Markdown content={Astro.props.body} sanitize={{allowComponents: true}} components={entryComponents}/>
    </div>

    <Comments slot="comments" client:visible discussionId={Astro.props.post.discussionId} author={Astro.props.post.author}/>
</PostLayout>
