---
import Layout from "../layouts/Layout.astro";
import {Markdown} from 'astro-remote';
import {entryComponents} from "../components/Entry/components";
import {getEntry} from "astro:content";

const entry = await getEntry('pages', 'legal')!;
---

<Layout title="Legal notice" description="Legal notice and terms of use for the IOKode project.">
    <div class="prose full">
        <Markdown content={entry.body} sanitize={{allowComponents: true}} components={entryComponents}/>
    </div>
</Layout>