---
import Layout from "../layouts/Layout.astro";
import PostIndex from "../components/PostIndex.astro";
import {getIndexPosts, getPageCount, postsPerPage} from "../helpers/pagination";

const allPosts = await getIndexPosts();
const posts = allPosts.slice(0, postsPerPage);
const pageCount = getPageCount(allPosts.length);
---

<Layout title="" description="The opinionated tech blog. Discover the latest posts and browse our archive.">
    <h1 class="eyebrow">Latest posts</h1>

    <PostIndex posts={posts} page={1} pageCount={pageCount}/>
</Layout>
