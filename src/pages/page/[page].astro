---
import Layout from "../../layouts/Layout.astro";
import PostIndex from "../../components/PostIndex.astro";
import {getIndexPosts, getPageCount, postsPerPage} from "../../helpers/pagination";

/** Pages two and up. Page one is `/`, so it is deliberately not generated here. */
export const getStaticPaths = async () => {
    const allPosts = await getIndexPosts();
    const pageCount = getPageCount(allPosts.length);

    return Array.from({length: Math.max(0, pageCount - 1)}, (_, index) => {
        const page = index + 2;
        return {
            params: {page: String(page)},
            props: {
                posts: allPosts.slice((page - 1) * postsPerPage, page * postsPerPage),
                page,
                pageCount,
            },
        };
    });
};

const {posts, page, pageCount} = Astro.props;
---

<Layout
    title={`Posts, page ${page}`}
    description={`Page ${page} of ${pageCount} of the IOKode post index.`}
>
    <h1 class="eyebrow">Latest posts — page {page}</h1>

    <PostIndex posts={posts} page={page} pageCount={pageCount}/>
</Layout>
