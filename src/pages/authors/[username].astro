---
import {getCollection, getEntry} from "astro:content";
import {Markdown} from "astro-remote";
import {entryComponents} from "../../components/Entry/components";
import Layout from "../../layouts/Layout.astro";
import PostArchive from "../../components/PostArchive.astro";
import Icon from "../../components/Icon.astro";
import {comparePostsByChronologicalPositionDescending} from "../../helpers/posts";

export const getStaticPaths = async () => {
    const posts = await getCollection('posts');
    const authors = [...new Set(posts.map(post => post.data.author))];

    return authors.map(author => ({
        params: {username: author},
        props: {username: author}
    }));
};

const {username} = Astro.props;

const posts = (await getCollection('posts'))
    .sort(comparePostsByChronologicalPositionDescending)
    .filter(post => post.data.author === username);

const name = posts[0].data.authorName || username;
const entry = await getEntry('authors', username)!;
---

<Layout title={`Posts by ${name}`} description={`Archive of all blog posts written by ${name}`}>
    <p class="back">
        <a class="button ghost small" href="/authors">
            <Icon name="arrow-left" size={15}/>
            Authors
        </a>
    </p>

    <header class="author-header">
        <span class="avatar"><img src={`https://github.com/${username}.png`} alt={`GitHub avatar of ${name}`}/></span>
        <h1>{name}</h1>
        <p class="metadata">
            <span>{posts.length} post{posts.length === 1 ? '' : 's'}</span>
            <span class="separator">/</span>
            <a href={`https://github.com/${username}`} target="_blank" rel="noopener">{username} on GitHub</a>
        </p>
    </header>

    <div class="biography prose">
        <Markdown content={entry.body} sanitize={{allowComponents: true}} components={entryComponents}/>
    </div>

    <PostArchive posts={posts} showAuthor={false}/>
</Layout>

<style>
    .back {
        /* Box model */
        margin: 0 0 var(--space-6);
    }

    .author-header {
        /* Box model */
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-areas:
                "avatar name"
                "avatar metadata";
        align-content: center;
        column-gap: var(--space-7);
        margin-bottom: var(--space-8);

        > .avatar {
            /* Box model */
            width: 5em;
            height: 5em;
            grid-area: avatar;
        }

        > h1 {
            /* Box model */
            grid-area: name;
            margin: 0 0 var(--space-2);

            /* Typographic */
            font-size: var(--font-size-2xl);
        }

        > .metadata {
            /* Box model */
            grid-area: metadata;
            margin: 0;
        }
    }

    /* The measure comes from `.prose`; this only spaces the bio off the header. */
    .biography {
        /* Box model */
        margin-bottom: var(--space-10);
    }
</style>
