---
import {getCollection} from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostArchive from "../../components/PostArchive.astro";
import {comparePostsByChronologicalPositionDescending} from "../../helpers/posts";

let posts = (await getCollection('posts')).sort(comparePostsByChronologicalPositionDescending);

posts = posts.filter(post => !post.data.tags.includes('spanish-legacy-post'));

const tags = await getCollection('tags');
---

<Layout title="Archive" description="Archive of all IOKode blog posts organized by year. Browse through our collection of articles.">
    <h1>All posts archive</h1>
    <!-- The link stays on this line: Astro trims the newline before an inline element, which
         would glue it to the preceding word. -->
    <p>Every post, newest first, excluding the <a href="/archive/spanish-legacy-post">legacy posts in Spanish</a>.</p>

    <section class="filters">
        <h2 class="eyebrow">Filter by tag</h2>
        <ul class="tag-list">
            {tags.map(tag => (
                <li><a class="tag" href={`/archive/${tag.id}`}>{tag.id}</a></li>
            ))}
        </ul>
    </section>

    <PostArchive posts={posts}/>
</Layout>

<style>
    .filters {
        /* Box model */
        margin-top: var(--space-9);
    }
</style>
